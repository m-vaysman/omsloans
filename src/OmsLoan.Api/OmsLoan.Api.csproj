<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>dotnet-OmsLoan.Api-56ba73e3-eb36-44fd-8c9a-8a1f233e5645</UserSecretsId>
    <!--
      Windows-only APIs (Event Log, Windows Service Control Manager) go through
      OperatingSystem.IsWindows() rather than retargeting to net8.0-windows, so this stays on
      the same TFM as the rest of src/.
    -->
  </PropertyGroup>

  <PropertyGroup>
    <!--
      React review UI. Published into wwwroot so one process serves API + UI in Production
      (SpaHosting.cs). Development uses Vite separately — docs/api-windows-service.md.
    -->
    <SpaRoot>..\OmsLoan.Web\</SpaRoot>
    <SpaDist>$(SpaRoot)dist\</SpaDist>
    <!--
      -p:BuildSpaOnPublish=false skips the npm build; existing dist/ is still published so a
      pipeline that built the UI elsewhere does not pay twice.
    -->
    <BuildSpaOnPublish Condition="'$(BuildSpaOnPublish)' == ''">true</BuildSpaOnPublish>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventLog" Version="8.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OmsLoan.Domain\OmsLoan.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      appsettings.Development.json is gitignored, so the tracked file is a template that a
      developer copies. Copied when present so a local override still reaches the output.
    -->
    <None Update="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.Development.json')" />
    <None Update="appsettings.Production.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Publish-only. Attaching to Build would put Node in the way of `dotnet build` / `dotnet
    test` on every clean clone for something only deploy needs.
  -->
  <Target Name="PublishOmsLoanWeb" AfterTargets="ComputeFilesToPublish">
    <Exec Command="npm ci"
          WorkingDirectory="$(SpaRoot)"
          Condition="'$(BuildSpaOnPublish)' == 'true' And !Exists('$(SpaRoot)node_modules')" />
    <Exec Command="npm run build"
          WorkingDirectory="$(SpaRoot)"
          Condition="'$(BuildSpaOnPublish)' == 'true'" />

    <ItemGroup>
      <SpaDistFiles Include="$(SpaDist)**" />
      <!--
        Exclude already-resolved items so dual presence does not duplicate-error at copy.
      -->
      <ResolvedFileToPublish Include="@(SpaDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>

    <!--
      Message, not Warning: API-only publish is supported; the service banner says the same.
    -->
    <Message Importance="high"
             Condition="'@(SpaDistFiles)' == ''"
             Text="No React build found at $(SpaDist) — publishing the API without the review UI." />
    <Message Importance="high"
             Condition="'@(SpaDistFiles)' != ''"
             Text="Publishing @(SpaDistFiles->Count()) React build file(s) into wwwroot." />
  </Target>

</Project>
