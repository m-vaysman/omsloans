<Project>

  <!--
    Scoped to src/ deliberately. The pre-existing WPF projects (OMS.Loans, LoanDbModel)
    live at the repo root, target net8.0-windows, and are not warning-clean; a root-level
    props file would break them.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    NuGet audit warnings are published against transitive packages after the fact, so
    promoting them to errors makes a previously-green clean clone fail on someone else's
    schedule. They stay warnings and stay visible.
  -->
  <PropertyGroup>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
