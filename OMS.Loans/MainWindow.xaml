<dx:ThemedWindow
    x:Class="OMS.Loans.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxa="http://schemas.devexpress.com/winfx/2008/xaml/accordion"
    xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
    xmlns:viewmodels="clr-namespace:OMS.Loans.ViewModels"
    Icon="pack://application:,,,/Assets/LT_Logo.png"
    
    xmlns:views="clr-namespace:OMS.Loans.Views"
    xmlns:views1="clr-namespace:OMS.Loans.ViewModels.Views"
    Width="2000"
    Height="800"
    FontFamily="Arial"
    FontSize="12"
    FontWeight="DemiBold"
    Title="Loan Trader">
    <Grid>
        <Grid.Resources>
            <DataTemplate DataType="{x:Type viewmodels:BlotterViewModel}">
                <views:BlotterView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:BlotterEntriesViewModel}">
                <views:BlotterEntriesView />
            </DataTemplate>
            <viewmodels:MainViewModel x:Key="viewModel" />
        </Grid.Resources>
        <dxdo:DockLayoutManager
            ClosedPanelsBarVisibility="Never"
            DataContext="{StaticResource viewModel}"
            DockingStyle="VS2010"
            FloatingMode="Desktop"
            ItemsSource="{Binding ChildViews}">
            <dxdo:LayoutGroup Name="lgMainView" Orientation="Horizontal">
                <dxdo:LayoutPanel
                     
                    HorizontalAlignment="Left"
                    AllowClose="False"
                    AllowDock="True"
                    AutoHidden="True"
                    Name="lpBlotter"
                    Caption="Blotter"
                    ItemWidth="800"
                    ShowPinButton="True">
                    
                    <views:BlotterEntryView x:Name="vwBlotterEntryView" VerticalAlignment="Stretch" />
               
                </dxdo:LayoutPanel>
                <dxdo:LayoutPanel
                    HorizontalAlignment="Left"
                    AllowClose="False"
                    AllowDock="True"
                    AutoHidden="True"
                    Name="lpTestView"
                    ItemWidth="600"
                    Caption="Trade Entry"
                    ShowPinButton="True">
                    <views:TestView />
                </dxdo:LayoutPanel>
  
                <dxdo:LayoutPanel
       HorizontalAlignment="Left"
       AllowClose="False"
       AllowDock="True"
       AutoHidden="True"
       ItemWidth="800"
       Name="lpSettlementsView"
       Caption="Settlements"
       ShowPinButton="True">
                    <views1:SettlementsView x:Name="vwSettlementsView"/>
                </dxdo:LayoutPanel>
                <dxdo:LayoutPanel
       HorizontalAlignment="Left"
       AllowClose="False"
       AllowDock="True"
       AutoHidden="True"
       Caption="Breaks"
       ShowPinButton="True">
                    <TextBox/>
                </dxdo:LayoutPanel>
                <dxdo:LayoutPanel
      HorizontalAlignment="Left"
      AllowClose="False"
      AllowDock="True"
      AutoHidden="True"
      ItemWidth="500"
      Caption="MTM"
      ShowPinButton="True">
                    
                </dxdo:LayoutPanel>
                <dxdo:LayoutPanel
HorizontalAlignment="Left"
AllowClose="False"
AllowDock="True"
AutoHidden="True"
ItemWidth="500"
Caption="PNL"
ShowPinButton="True">

                </dxdo:LayoutPanel>
                <dxdo:LayoutPanel
HorizontalAlignment="Left"
AllowClose="False"
AllowDock="True"
AutoHidden="True"
ItemWidth="500"
Caption="Reporting"
ShowPinButton="True">

                </dxdo:LayoutPanel>
                <dxdo:LayoutPanel
HorizontalAlignment="Left"
AllowClose="False"
AllowDock="True"
AutoHidden="True"
ItemWidth="500"
Caption="Wires"
ShowPinButton="True">

                </dxdo:LayoutPanel>
                <dxdo:LayoutPanel
HorizontalAlignment="Left"
AllowClose="False"
AllowDock="True"
AutoHidden="True"
ItemWidth="500"
Caption="Breaks"
ShowPinButton="True">

                </dxdo:LayoutPanel>
                <dxdo:LayoutPanel
HorizontalAlignment="Left"
AllowClose="False"
AllowDock="True"
AutoHidden="True"
ItemWidth="500"
Caption="Facility Setup"
ShowPinButton="True">

                </dxdo:LayoutPanel>
                <dxdo:LayoutPanel
HorizontalAlignment="Left"
AllowClose="False"
AllowDock="True"
AutoHidden="True"
ItemWidth="500"
Caption="CASH MATCHING"
ShowPinButton="True">

                </dxdo:LayoutPanel>
            </dxdo:LayoutGroup>
        </dxdo:DockLayoutManager>
    </Grid>
</dx:ThemedWindow>