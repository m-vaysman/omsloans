<dx:ThemedWindow
    x:Class="OMS.Loans.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
    xmlns:views="clr-namespace:OMS.Loans.Views"
    xmlns:viewmodels="clr-namespace:OMS.Loans.ViewModels.Views"
    Icon="pack://application:,,,/Assets/LT_Logo.png"
    Width="1400"
    Height="800"
    FontFamily="Arial"
    FontSize="12"
    FontWeight="DemiBold"
    Title="Loan Trader"
    Loaded="ThemedWindow_Loaded"
    Closing="ThemedWindow_Closing">

    <dxdo:DockLayoutManager
        x:Name="DockManager"
        FloatingMode="Desktop">

        <dxdo:LayoutGroup Orientation="Horizontal">
            <dxdo:DocumentGroup>
                <dxdo:DocumentPanel Caption="Blotter" AllowClose="False" AllowDock="True">
                    <views:BlotterEntryView />
                </dxdo:DocumentPanel>
                <dxdo:DocumentPanel Caption="Trade Entry" AllowClose="False" AllowDock="True">
                    <views:TestView />
                </dxdo:DocumentPanel>
            </dxdo:DocumentGroup>

            <dxdo:LayoutGroup Orientation="Vertical" ItemWidth="360">
                <dxdo:LayoutPanel Caption="Settlements" AllowClose="False" AllowDock="True" AutoHidden="True" ShowPinButton="True">
                    <viewmodels:SettlementsView />
                </dxdo:LayoutPanel>
                <dxdo:LayoutPanel Caption="CASH MATCHING" AllowClose="False" AllowDock="True" AutoHidden="True" ShowPinButton="True">
                    <views:CashMatchingView />
                </dxdo:LayoutPanel>
                <dxdo:LayoutPanel Caption="Breaks" AllowClose="False" AllowDock="True" AutoHidden="True" ShowPinButton="True" />
            </dxdo:LayoutGroup>
        </dxdo:LayoutGroup>
    </dxdo:DockLayoutManager>
</dx:ThemedWindow>
