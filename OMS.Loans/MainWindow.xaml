<dx:ThemedWindow
    x:Class="OMS.Loans.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxa="http://schemas.devexpress.com/winfx/2008/xaml/accordion"
    xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
    xmlns:viewmodels="clr-namespace:OMS.Loans.ViewModels"
    xmlns:views="clr-namespace:OMS.Loans.Views"
    xmlns:views1="clr-namespace:OMS.Loans.ViewModels.Views"
    Icon="pack://application:,,,/Assets/LT_Logo.png"
    Width="2000"
    Height="800"
    FontFamily="Arial"
    FontSize="12"
    FontWeight="DemiBold"
    Title="Loan Trader">

    <Grid>
        <Grid.Resources>
            <DataTemplate DataType="{x:Type viewmodels:BlotterViewModel}">
                <views:BlotterView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:BlotterEntriesViewModel}">
                <views:BlotterEntriesView />
            </DataTemplate>
            <viewmodels:MainViewModel x:Key="viewModel" />
        </Grid.Resources>

        <dxdo:DockLayoutManager
            ClosedPanelsBarVisibility="Never"
            DataContext="{StaticResource viewModel}"
            DockingStyle="VS2010"
            FloatingMode="Desktop"
            ItemsSource="{Binding ChildViews}">

            <dxdo:LayoutGroup Name="lgMainView" Orientation="Horizontal">

                <!-- Blotter -->
                <dxdo:LayoutPanel
                    Name="lpBlotter"
                    Caption="Blotter"
                    ItemWidth="*"
                    HorizontalAlignment="Left"
                    AllowClose="False"
                    AllowDock="True"
                    AutoHidden="True"
                    ShowPinButton="True">
                    <views:BlotterEntryView x:Name="vwBlotterEntryView" VerticalAlignment="Stretch" />
                </dxdo:LayoutPanel>

                <!-- Trade Entry -->
                <dxdo:LayoutPanel
                    Name="lpTestView"
                    Caption="Trade Entry"
                    ItemWidth="600"
                    HorizontalAlignment="Left"
                    AllowClose="False"
                    AllowDock="True"
                    AutoHidden="True"
                    ShowPinButton="True">
                    <views:TestView />
                </dxdo:LayoutPanel>

                <!-- Settlements -->
                <dxdo:LayoutPanel
                    Name="lpSettlementsView"
                    Caption="Settlements"
                    ItemWidth="800"
                    HorizontalAlignment="Left"
                    AllowClose="False"
                    AllowDock="True"
                    AutoHidden="True"
                    ShowPinButton="True">
                    <views1:SettlementsView Width="400" x:Name="vwSettlementsView" />
                </dxdo:LayoutPanel>

                <!-- Breaks (TextBox Placeholder) -->
                <dxdo:LayoutPanel
                    Caption="Breaks"
                    HorizontalAlignment="Left"
                    AllowClose="False"
                    AllowDock="True"
                    ItemWidth="*"
                    AutoHidden="True"
                    ShowPinButton="True">
                    <views:CashMatchingView  />
                </dxdo:LayoutPanel>

                <!-- CASH MATCHING (TextBox Placeholder) -->
                <dxdo:LayoutPanel
                    Caption="CASH MATCHING"
                    MaxWidth="3500"
                    MaxHeight="1500"
                    HorizontalAlignment="Left"
                    AllowClose="False"
                    AllowDock="True"
                    AutoHidden="True"
                    ShowPinButton="True" >
                    <views:CashMatchingView/>
                </dxdo:LayoutPanel>


                <!-- Other Panels -->
                <dxdo:LayoutPanel Caption="MTM" HorizontalAlignment="Left" AllowClose="False" AllowDock="True" AutoHidden="True" ShowPinButton="True" />
                <dxdo:LayoutPanel Caption="PNL" ItemWidth="*" HorizontalAlignment="Left" AllowClose="False" AllowDock="True" AutoHidden="True" ShowPinButton="True" />
                <dxdo:LayoutPanel Caption="Reporting" ItemWidth="*" HorizontalAlignment="Left" AllowClose="False" AllowDock="True" AutoHidden="True" ShowPinButton="True" />
                <dxdo:LayoutPanel Caption="Wires" ItemWidth="*" HorizontalAlignment="Left" AllowClose="False" AllowDock="True" AutoHidden="True" ShowPinButton="True" />
                <dxdo:LayoutPanel Caption="Breaks" ItemWidth="*" HorizontalAlignment="Left" AllowClose="False" AllowDock="True" AutoHidden="True" ShowPinButton="True" />
                <dxdo:LayoutPanel Caption="Facility Setup" ItemWidth="500" HorizontalAlignment="Left" AllowClose="False" AllowDock="True" AutoHidden="True" ShowPinButton="True" />
               
            </dxdo:LayoutGroup>
        </dxdo:DockLayoutManager>
    </Grid>
</dx:ThemedWindow>
