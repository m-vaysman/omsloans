<UserControl x:Class="OMS.Loans.Views.ExpectedCashFlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OMS.Loans.Views" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:viewmodels="clr-namespace:OMS.Loans.ViewModels" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" d:DataContext="{d:DesignInstance Type=viewmodels:ExpectedCashFlowViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <dxlc:LayoutControl Orientation="Horizontal">
        <dxlc:LayoutItem VerticalAlignment="Stretch">
            <dxg:GridControl Background="Transparent"
                DesignTimeDataObjectType="{x:Type viewmodels:ExpectedCashFlowItemViewModel}"
                SelectedItem="{Binding SelectedItem}"
                ItemsSource="{Binding ExpectedCashFlowItems}"
                SelectionMode="Row">
               
                <dxg:GridControl.View>
                    <dxg:TableView ShowGroupPanel="False" 
                                   ShowVerticalLines="False"
                                   ShowIndicator="False"
                                   AllowHeaderNavigation="True"
                                   AllowDragDrop="True"
                                   TotalSummaryPosition="Bottom"
                                   AutoWidth="True"
                                   VerticalScrollbarVisibility="Hidden"
                                   DragEnter="TableView_DragEnter"
                                   >
                        <dxg:TableView.RowStyle>
                            <Style TargetType="dxg:RowControl">
                                <Setter Property="Background" Value="#FF7F50"/>
                            </Style>
                        </dxg:TableView.RowStyle>
                    </dxg:TableView>
                </dxg:GridControl.View>
                <dxg:GridColumn FieldName="Code" IsSmart="True"/>
                <dxg:GridColumn FieldName="CounterParty" IsSmart="True"/>
                <dxg:GridColumn FieldName="Source" IsSmart="True"/>
                <dxg:GridColumn FieldName="Amount" IsSmart="True"/>
                <dxg:GridColumn FieldName="ExpectedCashPaymentDate" IsSmart="True"/>
                <dxg:GridColumn Header="Match">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <dx:SimpleButton Background="Black" Command="{Binding DataContext.PublishSelectedItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Glyph="{dx:DXImage SvgImages/DiagramIcons/NextPage.svg}"  />
                            </StackPanel>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
            </dxg:GridControl>
        </dxlc:LayoutItem>
        <dxlc:LayoutItem HorizontalAlignment="Right" VerticalAlignment="Stretch">
            <dx:SimpleButton 
                HorizontalAlignment="Center"
                Command="{Binding PublishSelectedItemCommand}"
                VerticalAlignment="Center"
                Glyph="{dx:FontIconSource ColorName=Blue, Glyph=60890}"
                />
        </dxlc:LayoutItem>
    </dxlc:LayoutControl>
</UserControl>
