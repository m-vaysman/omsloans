<UserControl x:Class="OMS.Loans.ViewModels.Views.SettlementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OMS.Loans.ViewModels.Views"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             mc:Ignorable="d" 
             
             d:DesignHeight="450" d:DesignWidth="800">
    <dxlc:LayoutControl>
        <dxlc:LayoutGroup>
            <dxlc:LayoutItem>
                <dxg:GridControl MaxWidth="750" MaxHeight="600" SelectionMode="Row">
                    <dxg:GridControl.View>
                        <dxg:TableView AllowHeaderNavigation="True" ShowSearchPanelMode="Never" AllowGrouping="False" AllowMoveColumnToDropArea="False" BestFitMode="AllRows" BestFitModeOnSourceChange="AllRows" ShowGroupPanel="False"/>
                    </dxg:GridControl.View>
                    <dxg:GridColumn FieldName="TradeId"/>
                    <dxg:GridColumn FieldName="CounterParty"/>
                    <dxg:GridColumn FieldName="Loan"/>
                    <dxg:GridColumn FieldName="Notional"/>
                    <dxg:GridColumn FieldName="TradeDate"/>
                    <dxg:GridColumn FieldName="SettlementDate"/>
                    <dxg:GridColumn FieldName="Direction"/>
                    
                    <dxg:GridColumn FieldName="Settlement Documentation"/>
                    <dxg:GridColumn FieldName="IsSettled"/>
                    <dxg:GridColumn FieldName="ApplySettlement"/>
                </dxg:GridControl>
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>

</UserControl>
